# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Database (MySQL)
# Local:
DATABASE_URL="mysql://root:password@localhost:3306/calendly"
# Railway on Vercel (append these params for serverless):
# DATABASE_URL="mysql://USER:PASS@HOST:PORT/railway?connection_limit=1&connect_timeout=15&pool_timeout=15&sslaccept=accept_invalid_certs&allowPublicKeyRetrieval=true"

# Optional — Gmail notification emails after booking (both required to send)
# EMAIL_USER="you@gmail.com"
# EMAIL_PASS="your-app-password"

# Optional — link target for "View event in Calendly" (defaults to first CORS origin)
# WEB_APP_URL="http://localhost:5173"

# Signs host login cookies. Required in production, at least 32 characters.
# Generate one with: openssl rand -base64 48
# JWT_SECRET="replace-with-a-long-random-string"

# Optional: Google Calendar + Google Meet links on bookings. Set all three or none.
# Setup (Google Cloud console):
#   1. Create a project and enable the "Google Calendar API".
#   2. OAuth consent screen: External, add yourself under "Test users" while in Testing.
#   3. Credentials > Create OAuth client ID > Web application, and add this exact
#      Authorized redirect URI (the API's own URL, not the web app's):
#        http://localhost:4000/api/v1/integrations/google/callback
# GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."
# GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/integrations/google/callback"
