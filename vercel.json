{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter @calendly/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "HUSKY=0 pnpm install --prod=false",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://calendly-clone-server.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
